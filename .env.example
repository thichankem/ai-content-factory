[TEMPLATE]
# AI Content Factory - configuration template
# Copy to .env and adjust. Every variable is optional.

# --- Application -----------------------------------------------------------
CONTENT_FACTORY_APP_NAME=ai-content-factory
CONTENT_FACTORY_DEBUG=false

# --- Provider routing ------------------------------------------------------
# cost_first     -> try weak/cheap/local tier first, fall back to strong API
# quality_first -> try strong tier first, fall back to weak tier
CONTENT_FACTORY_PROVIDER_STRATEGY=cost_first

# --- Weak tier: local MoneyPrinterTurbo ------------------------------------
CONTENT_FACTORY_MONEY_PRINTER_ENABLED=true
CONTENT_FACTORY_MONEY_PRINTER_BASE_URL=http://127.0.0.1:8080
#CONTENT_FACTORY_MONEY_PRINTER_API_KEY=

# --- Strong tier ------------------------------------------------------------
# The strong tier tries its configured vendors in this order and uses the
# first one that is enabled and answers. Recognized names:
# anthropic | google | deepseek | openai
CONTENT_FACTORY_STRONG_PROVIDER_ORDER=anthropic,google,deepseek,openai
CONTENT_FACTORY_STRONG_MAX_TOKENS=4096

# --- Anthropic Claude (native /v1/messages) --------------------------------
CONTENT_FACTORY_ANTHROPIC_ENABLED=false
CONTENT_FACTORY_ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
#CONTENT_FACTORY_ANTHROPIC_API_KEY=
CONTENT_FACTORY_ANTHROPIC_MODEL=claude-sonnet-4-5
CONTENT_FACTORY_ANTHROPIC_VERSION=2023-06-01

# --- Google Gemini (native generateContent) --------------------------------
CONTENT_FACTORY_GOOGLE_ENABLED=false
CONTENT_FACTORY_GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta
#CONTENT_FACTORY_GOOGLE_API_KEY=
CONTENT_FACTORY_GOOGLE_MODEL=gemini-2.5-flash

# --- DeepSeek (OpenAI-compatible) ------------------------------------------
CONTENT_FACTORY_DEEPSEEK_ENABLED=false
CONTENT_FACTORY_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
#CONTENT_FACTORY_DEEPSEEK_API_KEY=
CONTENT_FACTORY_DEEPSEEK_MODEL=deepseek-chat

# --- Ollama local models (OpenAI-compatible /v1) ---------------------------
CONTENT_FACTORY_OLLAMA_ENABLED=false
CONTENT_FACTORY_OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
CONTENT_FACTORY_OLLAMA_API_KEY=ollama
CONTENT_FACTORY_OLLAMA_MODEL=qwen2.5:7b

# --- OpenAI-compatible endpoint (generic) ----------------------------------
# Works with OpenAI, OpenRouter, vLLM, Groq, Together, ...
CONTENT_FACTORY_STRONG_LLM_ENABLED=false
CONTENT_FACTORY_STRONG_LLM_BASE_URL=https://api.openai.com/v1
CONTENT_FACTORY_STRONG_LLM_API_KEY=
CONTENT_FACTORY_STRONG_LLM_MODEL=gpt-4o-mini
CONTENT_FACTORY_STRONG_LLM_TIMEOUT_SECONDS=90

# --- Built-in template provider (offline fallback) --------------------------
# Always-on local provider that drafts a script from the topic, so the
# pipeline works out of the box with no external service. Disable to force
# script generation to use real providers only.
CONTENT_FACTORY_TEMPLATE_ENABLED=true

# --- Scripting presets (user-tunable pipeline) ------------------------------
# Directory scanned for *.json / *.md style presets. See presets/README.md.
CONTENT_FACTORY_PRESETS_DIR=./presets

# --- External AI agent bridge ----------------------------------------------
# Export Markdown briefs and import results from Claude Code, Codex, ...
CONTENT_FACTORY_AGENT_BRIDGE_ENABLED=true

# --- Simulated video production ---------------------------------------------
# The vertical slice simulates rendering; these tune the fake worker.
CONTENT_FACTORY_GENERATION_STEPS=10
CONTENT_FACTORY_GENERATION_STEP_DELAY_SECONDS=0.3
CONTENT_FACTORY_VIDEO_FORMAT=mp4

# --- Text-to-speech (AI voiceover) -------------------------------------------
# engine: "edge" (neural, best quality) | "gtts" (fast fallback) | "off"
CONTENT_FACTORY_TTS_ENABLED=true
CONTENT_FACTORY_TTS_ENGINE=edge
#CONTENT_FACTORY_TTS_VOICE=vi-VN-HoaiMyNeural
CONTENT_FACTORY_TTS_RATE=+0%

# --- Research ---------------------------------------------------------------
# Maximum number of reference sources gathered per research pass.
CONTENT_FACTORY_RESEARCH_MAX_SOURCES=6

# --- Document search & library ----------------------------------------------
# Federated web search across arXiv, Crossref, Gutenberg, Open Library,
# Wikipedia, and Internet Archive. Disable for fully offline operation.
CONTENT_FACTORY_DOCUMENTS_WEB_ENABLED=true
CONTENT_FACTORY_DOCUMENTS_SEARCH_TIMEOUT_SECONDS=8
CONTENT_FACTORY_LIBRARY_DIR=./library
CONTENT_FACTORY_LIBRARY_DB_PATH=./library/.index.db
CONTENT_FACTORY_MEDIA_DIR=./library/media

# --- Content-addressed cache (idempotent checkpoints) ------------------------
# Expensive steps (transcription, vision scoring) memoize results here by
# content hash, so a retried pipeline resumes instead of recomputing.
CONTENT_FACTORY_CACHE_DIR=./storage/cache

# --- Optional vision layer ----------------------------------------------------
# Off by default: mechanical tasks never spend vision cost. Turn on only when a
# task must "understand" a frame. rule_based | claude | local
CONTENT_FACTORY_ENABLE_VISION=false
CONTENT_FACTORY_VISION_BACKEND=rule_based

# --- Optional audio perception layer ------------------------------------------
# "Hearing" the soundtrack. Silence/pace, music mood and technical quality run
# free (numpy + ffmpeg). Sound events, speaker diarization, speech emotion and
# natural scene description need an AI backend and are off by default.
# rule_based | ai
CONTENT_FACTORY_ENABLE_AUDIO_PERCEPTION=false
CONTENT_FACTORY_AUDIO_PERCEPTION_BACKEND=rule_based

# --- QA & traceability layer ---------------------------------------------------
# Append-only audit trail of every AI edit.
CONTENT_FACTORY_AUDIT_DIR=./storage/audit
# Cost guard: estimate USD cost of an expensive plan and require confirmation
# when it exceeds the threshold.
CONTENT_FACTORY_COST_GUARD_ENABLED=false
CONTENT_FACTORY_COST_GUARD_THRESHOLD_USD=5.0
CONTENT_FACTORY_COST_UNIT_VISION_USD=0.010
CONTENT_FACTORY_COST_UNIT_AUDIO_LLM_USD=0.020
CONTENT_FACTORY_COST_UNIT_TTS_USD=0.002
CONTENT_FACTORY_COST_UNIT_STT_USD=0.003
CONTENT_FACTORY_COST_UNIT_EMBEDDING_USD=0.0001

# --- Media intelligence ---------------------------------------------------------
# Max Hamming distance for perceptual-hash near-duplicate detection.
CONTENT_FACTORY_DEDUP_MAX_DISTANCE=4
# Semantic-search seam over the media library: lexical (default) | embedding.
CONTENT_FACTORY_SEARCH_EMBEDDER=lexical

# --- Resilience (applies to every provider adapter) ------------------------
CONTENT_FACTORY_HTTP_TIMEOUT_SECONDS=30
CONTENT_FACTORY_HTTP_CONNECT_TIMEOUT_SECONDS=5
CONTENT_FACTORY_RETRY_MAX_ATTEMPTS=3
CONTENT_FACTORY_RETRY_BASE_DELAY_SECONDS=0.5
CONTENT_FACTORY_RETRY_MAX_DELAY_SECONDS=30
CONTENT_FACTORY_RETRY_JITTER_RATIO=0.2
CONTENT_FACTORY_CIRCUIT_FAILURE_THRESHOLD=5
CONTENT_FACTORY_CIRCUIT_SUCCESS_THRESHOLD=2
CONTENT_FACTORY_CIRCUIT_OPEN_TIMEOUT_SECONDS=30
CONTENT_FACTORY_RATE_LIMIT_CAPACITY=4
CONTENT_FACTORY_RATE_LIMIT_REFILL_PER_SECOND=2
